# Salin menjadi .env.local lalu isi sendiri. Jangan commit file .env.local.
# Penjelasan setiap variabel: README › Variabel lingkungan (sumber: lib/env-schema.ts).

# Wajib untuk data asli. Kosong = Demo Mode.
INTERVALS_API_KEY=
# Opsional. Kosong atau 0 = atlet pemilik API key.
INTERVALS_ATHLETE_ID=0

# Sandi aplikasi (wajib di tombol Deploy). Kosong di komputer sendiri = aplikasi tidak dikunci.
# APP_PASSCODE minimal 8 karakter; SESSION_SECRET acak minimal 32 karakter (buat: npm run secret).
APP_PASSCODE=
SESSION_SECRET=

# Opsional: sinkron antar perangkat. Di Vercel diisi otomatis oleh integrasi Upstash Redis.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
