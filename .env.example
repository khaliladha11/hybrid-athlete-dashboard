# Salin menjadi .env.local lalu isi. Kosongkan INTERVALS_API_KEY untuk Demo Mode.
INTERVALS_API_KEY=
# 0 = atlet pemilik API key
INTERVALS_ATHLETE_ID=0
# Opsional (0.12): sandi aplikasi. Kosong = aplikasi tidak dikunci.
# APP_PASSCODE minimal 8 karakter; SESSION_SECRET acak minimal 32 karakter.
APP_PASSCODE=
SESSION_SECRET=
